@page "/scans"
@using jVision.Shared.Models
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager NavigationManager

<h3>Scan Uploads</h3>
<p class="text-muted" style="margin-bottom:16px;">
    Share raw nmap XMLs with the team &mdash; e.g. after a manual
    <code>nmap -sV -p- -oX myscan.xml &lt;target&gt;</code>. Everyone can browse
    &amp; download; only the uploader can delete their own file.
</p>

<div class="shadow" style="padding:16px; margin-bottom:24px;">
    <h5>Upload</h5>
    <div class="form-group">
        <label>Note (target, method, whatever helps teammates find it later)</label>
        <input class="form-control" placeholder="e.g. full -p- against 10.0.5.0/24"
               @bind="_note" />
    </div>
    <div class="form-check" style="margin-bottom:8px;">
        <input class="form-check-input" type="checkbox" id="importToHome" @bind="_importToHome" />
        <label class="form-check-label" for="importToHome">
            Also import into Home
            <span class="text-muted">
                <small>(adds an "Uploaded" button on each affected IP row; does
                NOT touch existing services on those boxes)</small>
            </span>
        </label>
    </div>
    <div class="d-flex align-items-center" style="gap:12px;">
        <InputFile OnChange="HandleFileSelected" accept=".xml,.txt,.gnmap,.nmap" />
        @if (_uploading)
        {
            <span class="text-muted">uploading &hellip;</span>
        }
    </div>
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" style="margin-top:12px;">@_error</div>
    }
    @if (!string.IsNullOrEmpty(_status))
    {
        <div class="alert alert-success" style="margin-top:12px;">@_status</div>
    }
</div>

@if (_scans == null)
{
    <p><em>Loading&hellip;</em></p>
}
else if (_scans.Count == 0)
{
    <p><em>Nothing uploaded yet.</em></p>
}
else
{
    <table class="table table-sm table-hover">
        <thead>
            <tr>
                <th>When</th>
                <th>Uploader</th>
                <th>File</th>
                <th>Size</th>
                <th>Note</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in _scans)
            {
                <tr>
                    <td><small>@s.UploadedAt.ToLocalTime().ToString("MM-dd HH:mm")</small></td>
                    <td>@s.Uploader</td>
                    <td>
                        <a href="scans/@s.ScanUploadId" target="_blank">@s.FileName</a>
                    </td>
                    <td><small>@FormatSize(s.SizeBytes)</small></td>
                    <td><small>@s.Note</small></td>
                    <td>
                        @if (string.Equals(s.Uploader, _me, StringComparison.OrdinalIgnoreCase))
                        {
                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => Delete(s.ScanUploadId)" title="delete">
                                <span class="oi oi-trash"></span>
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Inject] public HttpClient Http { get; set; }

    private List<ScanUpload> _scans;
    private HubConnection _hub;
    private string _note = "";
    private string _error;
    private string _status;
    private bool _uploading;
    private bool _importToHome;
    private string _me = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var cu = await Http.GetFromJsonAsync<CurrentUser>("Auth/CurrentUserInfo");
            _me = cu?.UserName ?? "";
        }
        catch { /* leave _me empty; delete buttons just won't render */ }

        await LoadList();

        _hub = new HubConnectionBuilder().WithUrl(NavigationManager.ToAbsoluteUri("/boxhub")).Build();
        _hub.On<ScanUpload>("ScanUploaded", s =>
        {
            _scans?.Insert(0, s);
            InvokeAsync(StateHasChanged);
        });
        _hub.On<int>("ScanDeleted", id =>
        {
            _scans?.RemoveAll(x => x.ScanUploadId == id);
            InvokeAsync(StateHasChanged);
        });
        await _hub.StartAsync();
    }

    private async Task LoadList()
    {
        try { _scans = await Http.GetFromJsonAsync<List<ScanUpload>>("scans"); }
        catch (Exception e) { _error = e.Message; }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        _error = _status = null;
        _uploading = true;
        try
        {
            var f = e.File;
            // 100 MB matches the server-side MaxUploadBytes. OpenReadStream
            // needs an explicit cap or it caps at 500 KB (Blazor default).
            var stream = f.OpenReadStream(100L * 1024 * 1024);
            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new MediaTypeHeaderValue("application/octet-stream");
            content.Add(fileContent, "file", f.Name);
            content.Add(new StringContent(_note ?? ""), "note");
            content.Add(new StringContent(_importToHome ? "true" : "false"), "importToHome");

            var r = await Http.PostAsync("scans", content);
            if (!r.IsSuccessStatusCode)
            {
                _error = $"upload failed: {(int)r.StatusCode} {r.ReasonPhrase}";
            }
            else
            {
                _status = "uploaded " + f.Name;
                _note = "";
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _uploading = false; }
    }

    private async Task Delete(int id)
    {
        var r = await Http.DeleteAsync("scans/" + id);
        if (!r.IsSuccessStatusCode) _error = "delete failed: " + r.ReasonPhrase;
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return bytes + " B";
        if (bytes < 1024 * 1024) return (bytes / 1024.0).ToString("F1") + " KB";
        return (bytes / (1024.0 * 1024.0)).ToString("F1") + " MB";
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub != null) await _hub.DisposeAsync();
    }
}

    // Per-host delete. Confirm against the browser so a mis-click can't wipe a
    // host silently -- the hub broadcast then removes the row for every client.
    private async Task DeleteBox(BoxDTO b)
    {
        if (b == null) return;
        var label = string.IsNullOrEmpty(b.Hostname) ? b.Ip : $"{b.Hostname} ({b.Ip})";
        var ok = await _JSRuntime.InvokeAsync<bool>("confirm", $"Delete host {label}? This cannot be undone.");
        if (!ok) return;
        try
        {
            var resp = await Http.DeleteAsync($"Box/{b.BoxId}");
            if (!resp.IsSuccessStatusCode)
            {
                await _JSRuntime.InvokeVoidAsync("alert", $"Delete failed: {(int)resp.StatusCode} {resp.ReasonPhrase}");
                return;
            }
            // Optimistic local removal in case the SignalR broadcast is slow;
            // the BoxDeleted handler is idempotent on an already-removed row.
            var gone = boxes.FirstOrDefault(x => x.BoxId == b.BoxId);
            if (gone != null) boxes.Remove(gone);
            Search();
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            await _JSRuntime.InvokeVoidAsync("alert", "Delete failed: " + e.Message);
        }
    }

    // Nuke-every-host. Two-step confirm so this stays hard to trigger by accident.
    private async Task DeleteAllBoxes()
    {
        var count = boxes?.Count ?? 0;
        var ok = await _JSRuntime.InvokeAsync<bool>(
            "confirm", $"Delete ALL {count} hosts? This cannot be undone.");
        if (!ok) return;
        try
        {
            var resp = await Http.DeleteAsync("Box/all");
            if (!resp.IsSuccessStatusCode)
            {
                await _JSRuntime.InvokeVoidAsync("alert", $"Delete-all failed: {(int)resp.StatusCode} {resp.ReasonPhrase}");
                return;
            }
            boxes.Clear();
            Search();
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            await _JSRuntime.InvokeVoidAsync("alert", "Delete-all failed: " + e.Message);
        }
    }


@inject IJSRuntime JSRuntime
@using System.Threading
@implements IDisposable 

<div class="form-inline">
    @if (Large)
    {
        <button type="button" class="btn btn-primary " @onclick="CopyTextToClipboard" disabled=@_disabled>
            @Title <i class="@_state p-1"></i>
        </button>
    }
    else
    {
        <button type="button" class="btn btn-primary btn-sm " @onclick="CopyTextToClipboard" disabled=@_disabled>
            @Title <i class="@_state p-1"></i>
        </button>
    }
</div>

@code {
    [Parameter] public bool Large { get; set; } = true;
    [Parameter] public string Text { get; set; }
    [Parameter] public string Title { get; set; }
    CancellationTokenSource cts = new();
    private string _state = "oi oi-clipboard";
    private bool _disabled = false;
    private async Task CopyTextToClipboard()
    {
        var tempState = _state;
        var tempDisabled = _disabled;
        // Show the tick only once the copy actually succeeded -- this used to
        // flip to a tick before the interop call, so a throwing clipboard API
        // still looked like it had worked.
        try
        {
            // execCommand reports failure by returning false rather than
            // throwing, so a bool result is the only honest signal here.
            var ok = await JSRuntime.InvokeAsync<bool>("clipboardCopy.copyText", Text);
            _state = ok ? "oi oi-check" : "oi oi-warning";
        }
        catch (JSException)
        {
            _state = "oi oi-warning";
        }
        _disabled = true;
        await Task.Delay(TimeSpan.FromSeconds(2), cts.Token);
        _state = tempState;
        _disabled = tempDisabled;
    }
    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}